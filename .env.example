# Backend. Defaults to the production API if unset or blank.
VITE_API_URL=https://blorbmart-tr1i.onrender.com

# Web push certificate (public key) for the vendor web-app registration.
#
# Optional. Without it Firebase falls back to its own default key, which is
# what the Flutter web build has always used. Set it only if this web app is
# given its own certificate in the Firebase console.
VITE_FIREBASE_VAPID_KEY=

# Cloudinary unsigned upload. Must match an UNSIGNED preset on the cloud, or
# every photo upload answers 400 "Upload preset not found".
VITE_CLOUDINARY_CLOUD=dwshyzftx
VITE_CLOUDINARY_PRESET=blorbmart
